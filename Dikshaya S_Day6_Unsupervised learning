    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "from sklearn.cluster import DBSCAN\n",
    "\n",
    "print(\"Libraries imported successfully\")\n",
    "customers = pd.DataFrame({\n",
    "    \"AnnualSpend\": [20, 22, 25, 27, 30, 75, 78, 80, 85, 88, 40, 42],\n",
    "    \"VisitsPerMonth\": [2, 3, 2, 4, 3, 8, 9, 8, 10, 9, 4, 5]\n",
    "})\n",
    "\n",
    "print(customers)\n",
    "plt.scatter(customers[\"AnnualSpend\"], customers[\"VisitsPerMonth\"])\n",
    "\n",
    "plt.xlabel(\"Annual Spend\")\n",
    "plt.ylabel(\"Visits Per Month\")\n",
    "plt.title(\"Customer Data Before Clustering\")\n",
    "\n",
    "plt.show()\n",
    "scaler = StandardScaler()\n",
    "\n",
    "X_scaled = scaler.fit_transform(customers)\n",
    "\n",
    "print(\"Data scaled successfully\")\n",
    "print(X_scaled)\n",
    "db = DBSCAN(eps=0.8, min_samples=2)\n",
    "\n",
    "db_labels = db.fit_predict(X_scaled)\n",
    "\n",
    "print(\"Cluster labels:\", db_labels)\n",
    "print(\"Noise points:\", sum(db_labels == -1))\n",
    "plt.scatter(\n",
    "    customers[\"AnnualSpend\"],\n",
    "    customers[\"VisitsPerMonth\"],\n",
    "    c=db_labels\n",
    ")\n",
    "\n",
    "plt.xlabel(\"Annual Spend\")\n",
    "plt.ylabel(\"Visits Per Month\")\n",
    "plt.title(\"DBSCAN Customer Clustering\")\n",
    "\n",
    "plt.show()\n",
    "customers[\"Cluster\"] = db_labels\n",
    "\n",
    "print(customers)\n",
    "db_test = DBSCAN(eps=0.2, min_samples=2)\n",
    "\n",
    "test_labels = db_test.fit_predict(X_scaled)\n",
    "\n",
    "print(\"New cluster labels:\", test_labels)\n",
    "print(\"Noise points:\", sum(test_labels == -1))"
   ]
